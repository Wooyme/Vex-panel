# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MQTT-over-WebSocket endpoint. Browsers require ws:// or wss:// (not mqtt://).
VITE_MQTT_BROKER_URL="ws://localhost:9001"

# Local panel backend used by the Vite development proxy.
PANEL_BACKEND_URL="http://localhost:5000"

# Optional server overrides. Defaults are shown below.
HOST="0.0.0.0"
PORT="5000"
ROBOT_ASSETS_DIR="assets"
FRONTEND_DIST_DIR="dist"
